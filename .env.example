# RELIF HOSPITAL — Environment Variables

# Copy this file to .env.local for local development
# Never commit .env.local to version control

# ── App Settings ───────────────────────────────────────────────────────────
VITE_DEMO_MODE=true
VITE_USE_EMULATORS=true
VITE_APP_URL=http://localhost:5173

# ── Emergency Contact (Demo — not real numbers) ────────────────────────────
VITE_EMERGENCY_NUMBER=+91-XXXX-XXXXXX
VITE_AMBULANCE_NUMBER=+91-XXXX-XXXXXX

# ── Firebase Configuration ─────────────────────────────────────────────────
# Get these from your Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:your-app-id

# ── Payment (Sandbox mode) ─────────────────────────────────────────────────
# VITE_RAZORPAY_KEY_ID=rzp_test_xxx  # Never put secret key here

# ── Maps ───────────────────────────────────────────────────────────────────
# VITE_GOOGLE_MAPS_KEY=your-maps-key

# ── AI Assistant ───────────────────────────────────────────────────────────
# VITE_AI_PROVIDER=gemini   # API key stays in Cloud Functions, never here

